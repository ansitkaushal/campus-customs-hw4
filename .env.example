# Copy this file to .env (in the hw4/ folder) and fill in your own values.
# .env is gitignored. Never commit real keys.

# Portkey API key used for all model calls (required for the chatbot)
PORTKEY_API_KEY=your-portkey-api-key-here

# Secret used to sign login session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace-with-a-long-random-string

# Optional: override the chat model (default: gpt-5.6-luna)
# CHAT_MODEL=gpt-5.6-luna
